# =============================================================================
# GlobeHunters Frontend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Next.js automatically loads .env, .env.local, .env.development, .env.production
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
#
# For scripts, run with:  node -r dotenv/config scripts/<script>.mjs
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_CONTACT_PHONE=020 4502 2984

# -----------------------------------------------------------------------------
# Debug Flags
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEBUG_FLIGHT_IDS=
NEXT_PUBLIC_DEBUG_FLIGHT_DATES=
NEXT_PUBLIC_DEBUG_HOTEL_DATES=

# -----------------------------------------------------------------------------
# Date Slider
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DATE_SLIDER_STAGGER_MS=500
NEXT_PUBLIC_DATE_SLIDER_CHUNK_SIZE=2

# -----------------------------------------------------------------------------
# Vyspa Flight Search API
# -----------------------------------------------------------------------------
VYSPA_API_URL=
VYSPA_API_VERSION=3
VYSPA_BRANCH_CODE=HQ
VYSPA_USERNAME=
VYSPA_PASSWORD=
VYSPA_TOKEN=
VYSPA_FLIGHTVIEW_URL=https://a1.stagev4.vyspa.net/anon.php

# -----------------------------------------------------------------------------
# Vyspa Hotels
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VYSPA_HOTELS_TIMEOUT_SEC=8
VYSPA_HOTELS_SEARCH_TIMEOUT_SEC=8
VYSPA_HOTELS_API_VERSION=1
VYSPA_HOTELS_AVAILABILITY_TIMEOUT_MS=
VYSPA_HOTELS_TIMEOUT_BUFFER_SEC=
VYSPA_HIDE_NO_IMAGE=
VYSPA_DEFAULT_CHILD_AGE=9

# -----------------------------------------------------------------------------
# Vyspa Live Properties
# -----------------------------------------------------------------------------
VYSPA_LIVEPROPERTIES_LIMIT=500
VYSPA_LIVEPROPERTIES_MAX_PAGES=
VYSPA_LIVEPROPERTIES_TIMEOUT_MS=8000
VYSPA_LIVEPROPERTIES_PAGE_TIMEOUT_MS=4500

# -----------------------------------------------------------------------------
# Vyspa Packages
# -----------------------------------------------------------------------------
VYSPA_PACKAGE_SEARCH_TIMEOUT_SEC=
VYSPA_PACKAGE_SEARCH_TIMEOUT_BUFFER_SEC=5
VYSPA_PACKAGE_TRANSPORT_TIMEOUT_MS=0

# -----------------------------------------------------------------------------
# Vyspa Portal (CMS / Booking Management)
# -----------------------------------------------------------------------------
VYSPA_PORTAL_URL=https://portal.globehunters.com/jsonserver.php
VYSPA_PORTAL_USERNAME=
VYSPA_PORTAL_PASSWORD=
VYSPA_PORTAL_TOKEN=

# -----------------------------------------------------------------------------
# Hotel Provider
# -----------------------------------------------------------------------------
HOTELS_PROVIDER=vyspa
# HYBRID_INCLUDE_UNMAPPED_HOTELBEDS=true

# -----------------------------------------------------------------------------
# HotelBeds
# -----------------------------------------------------------------------------
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_BOOKING_BASE_URL=https://api.hotelbeds.com/hotel-api/1.0
HOTELBEDS_CONTENT_BASE_URL=https://api.hotelbeds.com/hotel-content-api/1.0
HOTELBEDS_DEFAULT_ADULT_AGE=
HOTELBEDS_DEFAULT_CHILD_AGE=9
HOTELBEDS_HIDE_NO_IMAGE=
HOTELBEDS_SEARCH_RADIUS_KM=
HOTELBEDS_ENRICH_LIMIT=
HOTELBEDS_ENRICH_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# Hotel UI
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SHOW_HOTEL_PROVIDER_IN_RESULTS=
NEXT_PUBLIC_ENABLE_HOTEL_PROVIDER_TOGGLE=
NEXT_PUBLIC_HYBRID_VYSPA_POLL_INTERVAL_MS=5000
NEXT_PUBLIC_HYBRID_VYSPA_MAX_POLLS=5

# -----------------------------------------------------------------------------
# SMTP / Email (Amazon SES)
# -----------------------------------------------------------------------------
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=bookings@globehunters.com

# -----------------------------------------------------------------------------
# BoxPay Payment Gateway
# -----------------------------------------------------------------------------
BOXPAY_MERCHANT_ID=zxVrRVIYGk
BOXPAY_BEARER_TOKEN=
BOXPAY_BASE_URL=https://test-apis.boxpay.tech
BOXPAY_CHECKOUT_URL=https://test-checkout.boxpay.tech
BOXPAY_STATUS_NOTIFY_URL=

# -----------------------------------------------------------------------------
# Yotpo Reviews
# -----------------------------------------------------------------------------
YOTPO_APP_KEY=
YOTPO_SECRET_KEY=

# -----------------------------------------------------------------------------
# TrustYou Hotel Reviews
# -----------------------------------------------------------------------------
TRUSTYOU_API_KEY=
TRUSTYOU_PARTNER_ID=
TRUSTYOU_PARTNER_IDS=

# -----------------------------------------------------------------------------
# Domain Simulation (dev only)
# -----------------------------------------------------------------------------
SIMULATE_DOMAIN=

# -----------------------------------------------------------------------------
# Scripts (dev/test helpers)
# -----------------------------------------------------------------------------
GH_BASIC_AUTH_B64=
LOCAL_API_URL=http://localhost:3001
LOCAL_BASE_URL=http://localhost:3000
